# Dependencies
node_modules/

# Secrets — never commit. Supply via the environment (local .env or the web
# environment's configured env-var/secret). .env.example is the committed template.
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Claude Code local settings (but track the shared project memory).
# Must be `.claude/*`, not `.claude/`: git cannot re-include a file whose
# parent directory is itself excluded, so the negation below would be ignored.
.claude/*
!.claude/MEMORY.md

# Memory/state files (optional - remove this line if you want to track state)
MEMORY/

# --- Platform additions (M3) ---
# Large media (videos/podcasts are YouTube/external-hosted; the build strips them)
*.mp4
*.mp3
*.mov
# Build output
dist/
# Vendored / scratch / legacy
design.md/
.playwright-mcp/
.superpowers/

# Playwright test output
test-results/
playwright-report/
# Local static-preview logs
.serve-*.log
# Source logo lives in assets/; ignore the root working copy
/VUB Logo.png
# Legacy course subrepos (archived in M3-D; tracked by their own git)
/VUB Financial Readiness Course/
/VUB Intermediate Computer Course/

# --- M3-D archive (retired copies live on disk for provenance; payload NOT tracked) ---
# Embedded repos carry their own .git; archive holds a 1.88 MB logo + HTML already
# committed canonically. Recovery = on-disk archive + freeze tag + git history.
/_archive/*
!/_archive/README.md

# --- Local scratch / junk / student PII — never commit (cleanup 2026-06-24) ---
# Stray static-preview error logs (companion to .serve-*.log above)
.serve-*.err
# "Save Page As" artifacts (…_files/ folders saved from the browser)
/VUB-Financial-Readiness_*_files/
# Student paperwork submissions — PII; must never reach a public repo
/VUB Financial Readiness Paperwork Submission/
