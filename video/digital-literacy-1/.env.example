# Digital Literacy — Level 1 video tooling: environment template.
#
# Copy this file to `.env` (in this folder OR the repo root) and fill in the value,
# OR set the same variable in your shell / the web environment's secret config.
# `.env` is git-ignored — never commit the real key.
#
# The narration generators (generate-*.mjs) auto-load `.env` via ./load-env.mjs.
# A value already present in the environment ALWAYS wins over the .env file, so a
# configured secret takes precedence over a local file.

# ElevenLabs API key — required to generate the voiceover MP3s.
# Get one at https://elevenlabs.io/ (Profile → API Keys).
ELEVENLABS_API_KEY=

# Optional: path to a chrome-headless-shell binary for `npm run render:*`.
# Set this in environments where Remotion cannot download its own headless
# Chromium (e.g. a network-restricted CI/cloud box). Use the *headless_shell*
# binary, NOT the full `chrome` (modern Chrome removed old headless mode). Leave
# blank to let Remotion manage its own browser. Example (a cloud container with
# Playwright's browsers pre-installed; the build number may differ):
#   REMOTION_BROWSER=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell
REMOTION_BROWSER=
